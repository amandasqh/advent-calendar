# Copy this to .env for local development: cp .env.example .env
# .env is gitignored -- real values never get committed.

DEBUG=True

# Leave these commented out locally -- safe dev fallbacks kick in
# (see mysite/settings.py). Set real values on Render's Environment tab.
# SECRET_KEY=
# DATABASE_URL=
# RESET_TOKEN=

# Optional: get a Telegram message whenever the server boots (see README).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
